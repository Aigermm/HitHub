import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D
# Антисимметриялы матрица A
A = np.array([
    [0, 1, 0, 0, 0],
    [-1, 0, 1, 0, 0],
    [0, -1, 0, 1, 0],
    [0, 0, -1, 0, 1],
    [0, 0, 0, -1, 0]
])
# Лотка–Вольтерра жүйесінің анықтамасы
def lotka_volterra(t, x):
    return x * (A @ x)
# Бастапқы шарт
x0 = np.array([1, 0.5, 0.8, 0.9, 1.1])
# Уақыт аралығы және дискретизация
t_span = (0, 50)
t_eval = np.linspace(*t_span, 1000)
# Жүйені шешу
sol = solve_ivp(lotka_volterra, t_span, x0, t_eval=t_eval)
# Шешімді бөліп алу
x = sol.y
t = sol.t
# График салу
fig = plt.figure(figsize=(12, 6))
# 3D фазалық портрет
ax = fig.add_subplot(121, projection='3d')
ax.plot(x[0], x[1], x[2])
ax.set_xlabel("x1")
ax.set_ylabel("x2")
ax.set_zlabel("x3")
ax.set_title("3D Phase Portrait: x1 vs x2 vs x3")
# 2D проекция
ax2 = fig.add_subplot(122)
ax2.plot(x[0], x[1])
ax2.set_xlabel("x1")
ax2.set_ylabel("x2")
ax2.set_title("2D Projection: x1 vs x2")
plt.tight_layout()
plt.show()
